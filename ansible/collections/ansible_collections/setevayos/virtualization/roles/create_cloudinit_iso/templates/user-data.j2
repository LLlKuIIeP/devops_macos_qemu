#cloud-config
hostname: {{ vm_hostname }}
manage_etc_hosts: true

users:
  - name: {{ cloud_user }}
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    passwd: "{{ cloud_user_password_hash }}"
    ssh_authorized_keys:
{% for key in ssh_authorized_keys %}
      - '{{ key }}'
{% endfor %}

chpasswd:
  expire: false

ssh_pwauth: {{ ssh_password_auth | lower }}

runcmd:
{% for cmd in runcmd %}
  - {{ cmd }}
{% endfor %}
